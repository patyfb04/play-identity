{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedOrigins": [
    "https://app.4.174.167.15.nip.io"
  ],

  "IdentitySettings": {
    "AdminUserEmail": "admin@play.com",
    "AdminUserPassword": "B@bies2020",
    "StartingGil": 100,

    // IdentityServer must use the public URL exposed by ingress
    "IssuerUri": "https://identity.4.174.167.15.nip.io/identity"
  },

  "IdentityServerSettings": {
    "Clients": [
      {
        "ClientId": "frontend",
        "AllowedGrantTypes": [ "authorization_code" ],
        "RequireClientSecret": false,
        "RequirePkce": true,

        "RedirectUris": [
          "https://app.4.174.167.15.nip.io/authentication/login-callback",
          "https://app.4.174.167.15.nip.io/authentication/silent-renew"
        ],

        "AllowedScopes": [
          "openid",
          "profile",
          "catalog.fullaccess",
          "inventory.fullaccess",
          "trading.fullaccess",
          "IdentityServerApi",
          "roles"
        ],

        "AlwaysIncludeUserClaimsInIdToken": true,

        "PostLogoutRedirectUris": [
          "https://app.4.174.167.15.nip.io/authentication/logout",
          "https://app.4.174.167.15.nip.io/authentication/logout-callback"
        ],

        "AllowedCorsOrigins": [
          "https://app.4.174.167.15.nip.io"
        ]
      },

      {
        "ClientId": "inventory-service",
        "ClientName": "Inventory Service",
        "AllowedGrantTypes": [ "client_credentials" ],
        "ClientSecrets": [
          {
            "Value": "B@bies2020",
            "Type": "SharedSecret"
          }
        ],
        "AllowedScopes": [ "catalog.readaccess" ]
      },

      {
        "ClientId": "trading-service",
        "ClientName": "Trading Service",
        "AllowedGrantTypes": [ "client_credentials" ],
        "ClientSecrets": [
          {
            "Value": "B@bies2020",
            "Type": "SharedSecret"
          }
        ],
        "AllowedScopes": [
          "catalog.readaccess",
          "inventory.readaccess",
          "trading.readaccess",
          "IdentityServerApi"
        ]
      },

      {
        "ClientId": "postman",
        "ClientName": "Postman Client",
        "AllowedGrantTypes": [ "authorization_code" ],
        "RequirePkce": true,
        "RedirectUris": [ "urn:ietf:wg:oauth:2.0:oob" ],
        "AllowedScopes": [
          "openid",
          "profile",
          "catalog.fullaccess",
          "inventory.fullaccess",
          "trading.fullaccess",
          "IdentityServerApi"
        ],
        "AllowAccessTokensViaBrowser": true,
        "RequireClientSecret": false
      }
    ],

    "ApiScopes": [
      {
        "Name": "catalog.fullaccess",
        "DisplayName": "Full access to Catalog API"
      },
      {
        "Name": "catalog.readaccess",
        "DisplayName": "Read access to Catalog API"
      },
      {
        "Name": "catalog.writeaccess",
        "DisplayName": "Write access to Catalog API"
      },
      {
        "Name": "inventory.fullaccess",
        "DisplayName": "Full access to Inventory API"
      },
      {
        "Name": "inventory.readaccess",
        "DisplayName": "Read access to Inventory API"
      },
      {
        "Name": "inventory.writeaccess",
        "DisplayName": "Write access to Inventory API"
      },
      {
        "Name": "trading.fullaccess",
        "DisplayName": "Full access to Trading API"
      },
      {
        "Name": "trading.readaccess",
        "DisplayName": "Read access to Trading API"
      },
      {
        "Name": "trading.writeaccess",
        "DisplayName": "Write access to Trading API"
      },
      {
        "Name": "IdentityServerApi",
        "DisplayName": "Full access to Identity API"
      }
    ],

    "ApiResources": [
      {
        "Name": "Catalog",
        "Scopes": [
          "catalog.fullaccess",
          "catalog.readaccess",
          "catalog.writeaccess"
        ],
        "UserClaims": [ "role" ]
      },
      {
        "Name": "Inventory",
        "Scopes": [
          "inventory.fullaccess",
          "inventory.readaccess",
          "inventory.writeaccess"
        ],
        "UserClaims": [ "role" ]
      },
      {
        "Name": "Trading",
        "Scopes": [
          "trading.fullaccess",
          "trading.readaccess",
          "trading.writeaccess"
        ],
        "UserClaims": [ "role" ]
      },
      {
        "Name": "IdentityApi",
        "Scopes": [ "IdentityServerApi" ],
        "UserClaims": [ "role" ]
      }
    ],

    "IdentityResources": [
      { "Name": "openid" },
      { "Name": "profile" }
    ]
  },

  "ConnectionStrings": {
    "ApplicationDbContextConnection": "Server=(localdb)\\mssqllocaldb;Database=Play.Identity.Service;Trusted_Connection=True;MultipleActiveResultSets=true"
  }
}